# Deskcomm isolated dental demo — Phoenix VPS
# Copy to .env.demo and replace every CHANGE_ME value.
# NEVER copy production Supabase credentials into this file.

DEMO_DOMAIN=demo.deskcomm.autocora.com.br
DEMO_APP_PORT=3300
DEMO_PROXY_NETWORK=easypanel
DEMO_APP_IMAGE=ghcr.io/leonardusrosa/deskcommcrm:latest
DEMO_APP_PULL_POLICY=always

NODE_ENV=production
DEMO_PROVISIONING_ENABLED=true

# Dedicated NON-PRODUCTION Supabase only.
NEXT_PUBLIC_SUPABASE_URL=https://kkbbqwhkkborpugmiqqq.supabase.co
SUPABASE_URL=https://kkbbqwhkkborpugmiqqq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_DB_URL=CHANGE_ME

# Public URL served by the Phoenix reverse proxy.
NEXT_PUBLIC_APP_URL=https://demo.deskcomm.autocora.com.br
NEXT_PUBLIC_ADMIN_URL=https://demo.deskcomm.autocora.com.br

# Generate independently for the demo installation.
INTERNAL_SECRET=CHANGE_ME
INTERNAL_CRON_SECRET=CHANGE_ME
CPF_ENCRYPTION_KEY=CHANGE_ME
AI_CRED_AES_KEY=CHANGE_ME
WAHA_BYO_ENCRYPTION_KEY=CHANGE_ME
IMPERSONATE_COOKIE_SECRET=CHANGE_ME
LGPD_SIGNING_KEY=CHANGE_ME

# Required by the production env contract, but no real transport exists in the
# demo stack. The compose file forces WAHA URLs to loopback port 9.
WAHA_API_KEY=demo-transport-disabled

# Local Redis REST adapter. These two values must match.
SRH_TOKEN=CHANGE_ME
UPSTASH_REDIS_REST_TOKEN=CHANGE_ME

# No AI provider is required for the synthetic showcase.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

NUVEMSHOP_ENABLED=false
INTERNAL_AGENT_RUN_STUB=false
SENTRY_DSN=off

APP_NAME=Deskcomm Demo
APP_LOGO_URL=
APP_ACCENT_HEX=
SUPPORT_EMAIL=
