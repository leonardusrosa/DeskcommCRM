# Copy this file to:
#   /etc/easypanel/traefik/config/deskcomm-demo.yml
#
# Replace demo.example.com with the real demo hostname before writing it.
# The service name below resolves through the existing attachable Easypanel
# overlay network, which the demo app joins as the external "proxy" network.

http:
  routers:
    deskcomm-demo-http:
      rule: Host(`demo.example.com`)
      entryPoints:
        - http
      middlewares:
        - deskcomm-demo-redirect
      service: deskcomm-demo

    deskcomm-demo-https:
      rule: Host(`demo.example.com`)
      entryPoints:
        - https
      service: deskcomm-demo
      tls:
        certResolver: letsencrypt

  middlewares:
    deskcomm-demo-redirect:
      redirectScheme:
        scheme: https
        permanent: true

  services:
    deskcomm-demo:
      loadBalancer:
        servers:
          - url: http://deskcomm-demo-app:3000
